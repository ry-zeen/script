-- AIMBOT & POV & SNAPLINE
-- =====================================================
local currentTarget = nil
task.spawn(function()
    while task.wait() do
        if S.Aimbot then
            local best, bestDist = nil, S.POVRadius
            local center = Camera.ViewportSize / 2
            
            for _, char in ipairs(GetTargets(S.AimTarget)) do
                local part = GetTargetPart(char, S.AimPart)
                if part then
                    local visible = true
                    if S.WallCheck then
                        local params = RaycastParams.new()
                        params.FilterType = Enum.RaycastFilterType.Exclude
                        params.FilterDescendantsInstances = {LocalPlayer.Character, char}
                        visible = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params) == nil
                    end
                    
                    if visible then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen and pos.Z > 0 then
                            local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                best = part
                            end
                        end
                    end
                end
            end
            
            currentTarget = best
            if currentTarget then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, currentTarget.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / S.AimSmooth)
            end
        else
            currentTarget = nil
        end
    end
end)

